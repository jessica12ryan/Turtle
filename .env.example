APP_NAME=Turtle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=turtle
DB_USERNAME=turtle
DB_PASSWORD=turtle
# DB_SOCKET=/tmp/mysql.sock  # Uncomment to connect via Unix socket instead of TCP

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@turtleapp.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Anonymous usage telemetry (opt-out, default ON). System + app context only
# (version, channel, arch, PHP, Docker vs HA). No users/tenants/properties.
# Token is a fine-grained PAT scoped ONLY to the private Turtle-Stats repo
# with repository_dispatch permission. A default token is bundled in the app;
# set TELEMETRY_TOKEN here only to override it (e.g. after a rotation).
TELEMETRY_ENABLED=true
TELEMETRY_REPO=jessica12ryan/Turtle-Stats
# TELEMETRY_TOKEN=<paste-fine-grained-pat-here>
