{
    "name": "jessica12ryan/turtle",
    "description": "Tenant management portal",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "phpcs": "phpcs",
        "lint": [
            "@analyse",
            "@phpcs"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
