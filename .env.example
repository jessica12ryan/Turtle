# Turtle environment configuration
# Only the variables below are read by the application. Settings edited in the
# UI (site URL, mail, telemetry, etc.) are stored in the database and take
# precedence over the values here.

APP_KEY=

# Database (a Unix socket can be used instead of host/port)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=turtle
DB_USERNAME=turtle
DB_PASSWORD=turtle
# DB_SOCKET=/tmp/mysql.sock

# Mail (SMTP). Configure in Settings -> General -> Email as an alternative.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@turtleapp.com"
MAIL_FROM_NAME="Turtle"

# Gmail OAuth2 (XOAUTH2) — set MAIL_AUTH_MODE=oauth2 and fill these in, or
# use Settings -> General -> Email.
MAIL_AUTH_MODE=password
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_REFRESH_TOKEN=
MAIL_OAUTH_EMAIL=

# Telemetry / Home Assistant integration (all optional)
TELEMETRY_ENABLED=
POSTHOG_HOST=
POSTHOG_KEY=
HASSIO=
SUPERVISOR_TOKEN=
