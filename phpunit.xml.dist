<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">www/Core</directory>
            <file>www/functions.php</file>
        </include>
    </source>
    <php>
        <!-- Defaults for host runs. The Docker test service sets the same
             values; integration tests additionally normalise them before the
             Database singleton is created. -->
        <env name="DB_HOST" value="mysql"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="turtle_test"/>
        <env name="DB_USERNAME" value="turtle"/>
        <env name="DB_PASSWORD" value="turtle"/>
        <env name="MYSQL_ROOT_PASSWORD" value="root"/>
        <ini name="date.timezone" value="UTC"/>
    </php>
</phpunit>
